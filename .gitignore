# Xcode and Apple build output
DerivedData/
.derivedData/
build/
*.xcresult/
*.xcactivitylog
*.xcuserstate
xcuserdata/

# Local machine metadata
.DS_Store
.AppleDouble
.LSOverride

# Python / ML experimentation environments
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
*.pt

# Generated or temporary ML output
*.mlmodelc/
*.tmp
*.cache

# Local credentials and app state
.env
.env.*
!.env.example
*.key
*.pem
*.p12

# Local distributables and presentation exports
*.ipa
*.docx
*.pptx

# Node dependencies (huge, reinstall with npm/pnpm install)
# MakePreview/node_modules is a symlink into FigmaMakeLatest-v3/node_modules,
# so it needs an explicit entry (directory patterns skip symlinks).
node_modules/
MakePreview/node_modules

# Web build output (runtime copy lives in Resources/FigmaMakeLatestWeb)
FigmaMakeLatest-v3/dist/

# Local screenshots and scratch exports
outputs/
*.mp4
